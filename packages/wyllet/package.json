{
  "name": "wyllet",
  "version": "1.0.0",
  "description": "The premium, open-source wallet connector for React dApps. Beautiful by default, customizable to the last pixel.",
  "license": "MIT",
  "homepage": "https://github.com/wyllet/wyllet#readme",
  "bugs": {
    "url": "https://github.com/wyllet/wyllet/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wyllet/wyllet.git",
    "directory": "packages/wyllet"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "connect-wallet",
    "connector",
    "dapp",
    "eip-6963",
    "ethereum",
    "react",
    "siwe",
    "viem",
    "wagmi",
    "wallet",
    "wallet-connector",
    "walletconnect",
    "web3"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "cp ../../README.md ../../LICENSE .",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5.0.0",
    "@walletconnect/ethereum-provider": "^2.21.1",
    "react": ">=18",
    "react-dom": ">=18",
    "viem": "^2.15.0",
    "wagmi": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@walletconnect/ethereum-provider": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.104.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@walletconnect/ethereum-provider": "^2.25.0",
    "jsdom": "^30.1.2",
    "jsqr": "^1.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "uqr": "0.1.3",
    "viem": "^2.57.3",
    "vitest": "^5.0.3",
    "wagmi": "^3.7.7"
  }
}
